(
    defaultPrim = "World"
    subLayers = [@./assets.usda@]
)

def Xform "World"
{
    def Scope "Recipes"
    {
        # Targets the composed dataset prim directly; no identifier.
        def Mesh "Faces" (
            prepend apiSchemas = [
                "CaeVizOperatorAPI",
                "CaeVizFacesAPI",
                "CaeVizDatasetSelectionAPI:source",
                "CaeVizFieldSelectionAPI:temperature"
            ]
        )
        {
            bool cae:viz:operator:enabled = true
            bool cae:viz:faces:externalOnly = true
            rel cae:viz:dataset_selection:source:target = </World/Assets/StaticMixer/Base/StaticMixer/StaticMixer_Default>
            token[] cae:viz:field_selection:temperature:fieldNames = ["Temperature"]
        }

        # Targets the holder and qualifies the dataset with a relative identifier.
        def Mesh "FacesByIdentifier" (
            prepend apiSchemas = [
                "CaeVizOperatorAPI",
                "CaeVizFacesAPI",
                "CaeVizDatasetSelectionAPI:source",
                "CaeVizFieldSelectionAPI:temperature"
            ]
        )
        {
            bool cae:viz:operator:enabled = true
            bool cae:viz:faces:externalOnly = true
            rel cae:viz:dataset_selection:source:target = </World/Assets/StaticMixer>
            string cae:viz:dataset_selection:source:identifier = "Base/StaticMixer/StaticMixer_Default"
            token[] cae:viz:field_selection:temperature:fieldNames = ["Temperature"]
        }
    }
}
