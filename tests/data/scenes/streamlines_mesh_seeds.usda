(
    defaultPrim = "World"
    subLayers = [@./assets.usda@]
)

def Xform "World"
{
    def Scope "Controls"
    {
        # Any UsdGeomPointBased prim seeds streamlines from its points; Kit-CAE
        # scenes commonly use a sphere Mesh positioned by its local transform.
        def Mesh "SeedQuad"
        {
            int[] faceVertexCounts = [3, 3]
            int[] faceVertexIndices = [0, 1, 2, 0, 2, 3]
            point3f[] points = [
                (1.0, 1.7320508, 0.5),
                (1.6558933, 1.1216137, 1.1121716),
                (-0.25716954, -1.0663241, 2.0),
                (0.92161566, 0.9685264, 0.6376164)
            ]
            double3 xformOp:translate = (0, 0.001, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Scope "Recipes"
    {
        def BasisCurves "Streamlines" (
            prepend apiSchemas = [
                "CaeVizOperatorAPI",
                "CaeVizStreamlinesAPI",
                "CaeVizDatasetSelectionAPI:source",
                "CaeVizDatasetSelectionAPI:seeds",
                "CaeVizFieldSelectionAPI:velocities"
            ]
        )
        {
            bool cae:viz:operator:enabled = true
            rel cae:viz:dataset_selection:source:target = </World/Assets/StaticMixer/Base/StaticMixer/B1_P3>
            rel cae:viz:dataset_selection:seeds:target = </World/Controls/SeedQuad>
            token[] cae:viz:field_selection:velocities:fieldNames = ["VelocityX", "VelocityY", "VelocityZ"]
            token cae:viz:streamlines:direction = "forward"
            int cae:viz:streamlines:maxSteps = 20
        }
    }
}
