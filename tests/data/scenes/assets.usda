def Xform "World"
{
    def Scope "Assets"
    {
        # The CAE file-format plug-ins compose this payload into OmniSciDataset
        # prims beneath the holder. ovstage has no such plug-ins: it keeps this
        # prim with its local opinions and nothing beneath it, silently.
        def "StaticMixer" (
            prepend apiSchemas = ["OmniSciFileFormatArgsCgnsAPI"]
            prepend payload = @../StaticMixer.cgns@
        )
        {
        }
    }
}
