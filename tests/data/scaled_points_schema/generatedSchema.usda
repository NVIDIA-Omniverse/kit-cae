(
    "Codeless schema for the test suite's ScaledPoints operator."
)

class "CaeVizScaledPointsAPI" (
    customData = {
        string userDocBrief = "Settings of the ScaledPoints test operator."
    }
)
{
    float cae:viz:scaled_points:scale = 1 (
        customData = {
            string userDocBrief = "Factor applied to the source points."
        }
        displayGroup = "Scaled Points"
        displayName = "Scale"
    )
}
