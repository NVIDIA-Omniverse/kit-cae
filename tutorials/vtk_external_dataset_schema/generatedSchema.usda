(
    "Codeless schema for the custom Data Source in appendix A2."
)

class "VtkExternalDatasetAPI" (
    customData = {
        string userDocBrief = "Marks a prim as a dataset held in files VTK can read, served by an application Data Source."
    }
)
{
    asset[] vtk:fileNames = [] (
        customData = {
            string userDocBrief = "The files holding the dataset. Time-sampled to describe a series; the sample at or before the requested time is read."
        }
        displayGroup = "VTK Dataset"
        displayName = "File Names"
    )
}
