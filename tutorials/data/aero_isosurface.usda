        custom int omni:rtx:usdluxVersion = 2505
        matrix4d xformOp:transform = ( (1, 0, 0, 0), (0, 0.9138115486202573, 0.40613846605344733, 0), (0, -0.40613846605344733, 0.9138115486202573, 0), (8, -2, 5, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def RectLight "UnderFill" (
        doc = "Broad upward-facing fill for the underside of the car, source, and downstream streamlines."
    )
    {
        color3f inputs:color = (1, 1, 1)
        float inputs:exposure = 0
        float inputs:height = 7
        float inputs:intensity = 560
        bool inputs:normalize = 0
        float inputs:width = 18
        custom int omni:rtx:usdluxVersion = 2505
        float3 xformOp:rotateXYZ = (180, 0, 0)
        double3 xformOp:translate = (5, 0, -3)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}

def Scope "Render"
{
    def RenderProduct "Camera"
    {
        uniform int2 resolution = (1280, 720)
        rel camera = </World/Camera>
        rel orderedVars = [<LdrColor>]

        def RenderVar "LdrColor"
        {
            uniform string sourceName = "LdrColor"
            opaque omni:rtx:aov
        }
    }
}
