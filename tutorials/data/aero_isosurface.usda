def Xform "World"
{
    def Scope "Looks"
    {
        def Material "SourceGlossyGrey"
        {
            token outputs:mdl:surface.connect = </World/Looks/SourceGlossyGrey/Shader.outputs:out>
            token outputs:surface.connect = </World/Looks/SourceGlossyGrey/PreviewSurface.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.28, 0.3, 0.33)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.12
                float inputs:specular_level = 0.5
                token outputs:out (
                    renderType = "material"
                )
            }

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.28, 0.3, 0.33)
                float inputs:metallic = 0
                float inputs:roughness = 0.12
                token outputs:surface
            }
        }

        def Material "TireRubber"
        {
            token outputs:mdl:surface.connect = </World/Looks/TireRubber/Shader.outputs:out>
