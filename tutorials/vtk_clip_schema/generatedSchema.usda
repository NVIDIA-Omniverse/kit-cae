(
    "Codeless schema for the VTK clip operator in appendix A3."
)

class "CaeVizVtkClipAPI" (
    customData = {
        string userDocBrief = "Settings of the tutorial's VTK clip operator, which keeps the part of a volume where a scalar exceeds a value."
    }
)
{
    float cae:viz:vtk_clip:value = 0 (
        customData = {
            string userDocBrief = "The clip value; cells where the clip field is at or above it are kept."
        }
        displayGroup = "VTK Clip"
        displayName = "Value"
    )
}
