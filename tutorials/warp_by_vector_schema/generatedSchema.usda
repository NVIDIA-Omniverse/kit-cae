(
    "Codeless schema for the Warp by Vector operator in tutorial 4."
)

class "CaeVizWarpByVectorAPI" (
    customData = {
        string userDocBrief = "Settings of the tutorial's Warp by Vector operator, which moves surface points along a nodal vector field."
    }
)
{
    float cae:viz:warp_by_vector:scale = 1 (
        customData = {
            string userDocBrief = "Dimensionless factor applied to the displacement before it is added to the points."
        }
        displayGroup = "Warp by Vector"
        displayName = "Scale"
    )
}
